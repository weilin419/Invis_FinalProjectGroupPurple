  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "There are two parts in this section to explore the lung position in chest.
    \r\n\r\nOn the right side, students are encouraged to hit the Left Arrow key
    or the Right Arrow key on the keyboard to control rotation of 3D model of organs
    in chest.\r\n\t(\u2190) Left Arrow key    --    turn left\r\n\t(\u2192) Right
    Arrow key  --    turn right\r\nThose provided buttons for a quick rotation to
    check organs from the Front, Back, Right, and Left side view.\r\n\r\nThe Rest
    button will reset any changes back to the original view of organ from the front.\r\n\r\nBy
    clicking on each organ model, you can highlight either one or some of them. Please
    ONLY select one organ to further develop details of it.\r\n\t[Space]      --   
    enter the \"Organ details\"\r\n\t[Escape]    --    end the \"Organ details\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
